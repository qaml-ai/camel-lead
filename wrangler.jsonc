{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camel-lead",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CAMELRUN_URL": "https://run-pilot.camelai.dev",
    "CAMEL_LEAD_URL": "https://camel-lead.miguel-85b.workers.dev",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true },
  },
  "durable_objects": {
    "bindings": [{ "name": "PROJECTS", "class_name": "ProjectRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }],
}
