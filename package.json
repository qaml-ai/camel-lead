{
  "name": "@qaml-ai/camel-lead",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "test": "vitest run",
    "test:node": "node --experimental-strip-types --test test/clients.test.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "dev": "wrangler dev",
    "check": "npm run test:oauth-patch && npm run types && npm run typecheck && npm test && npm run test:node",
    "build": "npm run test:oauth-patch && wrangler deploy --dry-run --outdir dist",
    "postinstall": "node scripts/patch-oauth-provider.mjs",
    "test:oauth-patch": "node --test test/oauth-patch.test.mjs"
  },
  "dependencies": {
    "@camelai/run": "^0.23.0",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@types/node": "^22",
    "typescript": "latest",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  }
}
