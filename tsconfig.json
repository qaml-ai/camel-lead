{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2024", "DOM"]
  },
  "include": [
    "src/**/*.ts",
    "clients/**/*.ts",
    "worker-configuration.d.ts",
    "scripts/**/*.ts"
  ]
}
